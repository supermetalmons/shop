{
  "name": "shop",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@firebase/util": true,
    "bigint-buffer": true,
    "bufferutil": true,
    "esbuild": true,
    "fsevents": true,
    "protobufjs": true,
    "re2": true,
    "utf-8-validate": true,
    "workerd": true
  },
  "description": "mons.shop – physically redeemable nft drops",
  "scripts": {
    "dev": "vite",
    "renderer": "vite --host 127.0.0.1 --port 5174 --open /renderer.html",
    "remotely": "node scripts/remotely.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "repo-clean": "bash ./scripts/repo-clean.sh",
    "latest": "npm exec --yes --package=node@22.23.1 --package=npm@12.0.2 -- node scripts/updateLatest.mjs",
    "latest:check": "npm exec --yes --package=node@22.23.1 --package=npm@12.0.2 -- node scripts/updateLatest.mjs --check",
    "typecheck": "node -e \"require('fs').mkdirSync('.cache',{recursive:true})\" && tsc --noEmit",
    "validate:lsb-cdn": "node --experimental-strip-types scripts/validate-lsb-cdn.ts",
    "validate:poncho-cdn": "node --experimental-strip-types scripts/validate-poncho-cdn.ts",
    "validate:card-nft-2-cdn": "node --experimental-strip-types scripts/validate-card-nft-2-cdn.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:dead-code": "knip",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:onchain": "cargo test --manifest-path onchain/Cargo.toml --locked",
    "check": "npm run typecheck && npm --prefix functions run check && npm run typecheck:tools && npm run check:dead-code && npm test && npm run test:onchain && npm run build && npm --prefix functions run build",
    "check-irl-claims": "tsx functions/scripts/checkIrlClaims.ts",
    "assign-stripe-order-cards": "tsx functions/scripts/assignStripeOrderCards.ts",
    "recover-card-nft-binder-oversell": "tsx functions/scripts/recoverCardNftBinderOversell.ts",
    "unstuck-processing-orders": "tsx functions/scripts/unstuckProcessingOrders.ts",
    "rebuild-pack-status": "tsx functions/scripts/rebuildPackStatus.ts",
    "test-resend-notification-email": "tsx functions/scripts/sendTestResendNotificationEmail.ts",
    "wipe-drop": "node --experimental-strip-types functions/scripts/wipeDrop.ts",
    "deploy": "node --experimental-strip-types scripts/deploy-cloudflare.ts",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes,functions",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firebaseNewDrops": "firebase deploy --only firestore:indexes,functions:solanaAuth,functions:getProfile,functions:listFulfillmentOrders,functions:listFulfillmentManualReviewCheckouts,functions:updateFulfillmentAddress,functions:updateFulfillmentStatus,functions:updateFulfillmentInternalStatus,functions:addFulfillmentOrderToShipStation,functions:listCardNft2UnrevealedCards,functions:revealDudes,functions:prepareAdminIrlRedeemTx,functions:prepareReceiptTransferTx,functions:finalizeAdminIrlRedeem,functions:prepareDeliveryTx,functions:issueReceipts,functions:recoverMyDeliveryOrders,functions:prepareIrlClaimTx,functions:claimStripeReceipt,functions:getAnonymousStripeDeliveryHistory,functions:createStripeCheckoutSession,functions:createTestStripeCheckoutSession,functions:stripeWebhook,functions:subscribeToNotifications,functions:processStripeCheckoutFulfillment,functions:notifyShippersOnDeliveryReadyToShip,functions:notifyBuyerOnDeliveryShipped,functions:notifyStripeCheckoutManualReview",
    "deploy-all-onchain": "node --experimental-strip-types scripts/deploy-all-onchain.ts",
    "deploy:lsb-uri-program": "node --experimental-strip-types scripts/deploy-lsb-uri-program.ts",
    "deploy:lsb-existing-uri-program": "node --experimental-strip-types scripts/deploy-lsb-uri-program.ts",
    "set:lsb-uri-base": "node --experimental-strip-types scripts/set-lsb-uri-base.ts",
    "deploy:poncho-uri-program": "node --experimental-strip-types scripts/deploy-poncho-uri-program.ts",
    "simulate:poncho-old-box": "node --experimental-strip-types scripts/simulate-poncho-old-box.ts",
    "set:poncho-uri-base": "node --experimental-strip-types scripts/set-poncho-uri-base.ts",
    "verify:mainnet-uri-migrations": "node --experimental-strip-types scripts/verify-mainnet-uri-migrations.ts",
    "deploy-receipt-pool": "node --experimental-strip-types scripts/deploy-receipt-pool.ts",
    "upgrade-onchain": "node --experimental-strip-types scripts/upgrade-onchain.ts",
    "start-mint": "node --experimental-strip-types scripts/startMint.ts",
    "set-mint-prices": "node --experimental-strip-types scripts/setMintPrices.ts",
    "export_collection_files": "node --experimental-strip-types scripts/exportCollectionFiles.ts",
    "get_token_holders": "node --experimental-strip-types scripts/getTokenHolders.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermetalmons/shop.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/supermetalmons/shop/issues"
  },
  "homepage": "https://github.com/supermetalmons/shop#readme",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-ledger": "^0.9.29",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "firebase": "^12.17.1",
    "jszip": "^3.10.1",
    "mediabunny": "^1.52.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "three": "^0.185.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "firebase-tools": "^15.25.1",
    "knip": "^6.31.0",
    "npm-check-updates": "^23.0.1",
    "tsx": "^4.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "wrangler": "4.118.0"
  }
}
