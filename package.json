{
  "name": "shop",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "bigint-buffer": true,
    "bufferutil": true,
    "esbuild": true,
    "fsevents": true,
    "protobufjs": true,
    "re2": true,
    "utf-8-validate": true,
    "workerd": true
  },
  "description": "mons.shop – physically redeemable nft drops",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "renderer": "vite --host 127.0.0.1 --port 5174 --open /renderer.html",
    "render:clear-cards": "node scripts/render-clear-cards.mjs",
    "remotely": "node scripts/remotely.cjs",
    "build": "vite build",
    "validate:browser-bundle": "node --experimental-strip-types scripts/validate-browser-bundle.ts",
    "validate:legacy-runtime": "node --experimental-strip-types scripts/validate-legacy-runtime.ts",
    "types:frontend-worker": "wrangler types cloud/workers/frontend/worker-configuration.d.ts --config wrangler.jsonc --env-file cloud/workers/frontend/release.env",
    "types:frontend-worker:check": "wrangler types cloud/workers/frontend/worker-configuration.d.ts --check --config wrangler.jsonc --env-file cloud/workers/frontend/release.env",
    "typecheck:frontend-worker": "tsc -p cloud/workers/frontend/tsconfig.json",
    "test:frontend-worker": "node --import tsx --test cloud/workers/frontend/test/*.test.ts",
    "check:frontend": "npm run validate:legacy-runtime && npm run types:frontend-worker:check && npm run typecheck:frontend-worker && npm run test:frontend-worker && npm run typecheck && npm test && npm run build && npm run validate:browser-bundle",
    "dry-run:frontend": "npm run check:frontend && wrangler deploy --dry-run --config wrangler.jsonc --env-file cloud/workers/frontend/release.env",
    "preview": "vite preview",
    "repo-clean": "bash ./scripts/repo-clean.sh",
    "latest": "npm exec --yes --package=node@22.23.1 --package=npm@12.0.2 -- node scripts/updateLatest.mjs",
    "latest:check": "npm exec --yes --package=node@22.23.1 --package=npm@12.0.2 -- node scripts/updateLatest.mjs --check",
    "typecheck": "node -e \"require('fs').mkdirSync('.cache',{recursive:true})\" && tsc --noEmit",
    "types:api": "wrangler types cloud/workers/api/worker-configuration.d.ts --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "types:api:check": "wrangler types cloud/workers/api/worker-configuration.d.ts --check --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "typecheck:api": "tsc -p cloud/workers/api/tsconfig.json",
    "test:api": "node --import tsx --test cloud/workers/api/test/*.test.ts tests/shopApiClient.test.ts",
    "test:api:runtime": "node --import tsx --test cloud/workers/api/runtime-test/*.test.ts",
    "dry-run:api": "node -e \"require('fs').mkdirSync('.cache',{recursive:true})\" && wrangler deploy --dry-run --outfile .cache/mons-shop-api-dry-run.js --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env && npm run validate:legacy-runtime -- .cache/mons-shop-api-dry-run.js",
    "startup:api": "node -e \"require('fs').mkdirSync('.cache',{recursive:true})\" && wrangler check startup --args=\"--config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env\" --outfile .cache/mons-shop-api-startup.cpuprofile",
    "check:api": "npm run validate:legacy-runtime && npm run types:api:check && npm run typecheck:api && npm run test:api && npm run test:api:runtime && npm run dry-run:api && npm run startup:api",
    "validate:lsb-cdn": "node --experimental-strip-types scripts/validate-lsb-cdn.ts",
    "validate:poncho-cdn": "node --experimental-strip-types scripts/validate-poncho-cdn.ts",
    "validate:card-nft-2-cdn": "node --experimental-strip-types scripts/validate-card-nft-2-cdn.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:dead-code": "knip",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:onchain": "cargo test --manifest-path onchain/Cargo.toml --locked",
    "test:onchain:sbf": "cd onchain && NO_DNA=1 anchor build --no-idl --arch sbf -- --features no-idl,no-log-ix-name,mainnet-program-id -- --locked && BOX_MINTER_SBF_PATH=\"$PWD/target/deploy/box_minter.so\" cargo test --locked --features sbf-tests,mainnet-program-id --test split_payments_sbf",
    "check": "npm run types:frontend-worker:check && npm run typecheck:frontend-worker && npm run test:frontend-worker && npm run typecheck && npm run check:api && npm run typecheck:tools && npm run check:dead-code && npm test && npm run test:onchain && npm run build && npm run validate:browser-bundle",
    "check-irl-claims": "tsx scripts/ops/checkIrlClaims.ts",
    "rebuild-pack-status": "tsx scripts/ops/rebuildPackStatus.ts",
    "db:migrate:data": "wrangler d1 migrations apply mons-shop-data --remote --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "db:migrate:ops": "wrangler d1 migrations apply mons-shop-ops --remote --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "db:migrate:commerce": "wrangler d1 migrations apply mons-shop-commerce --remote --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "db:migrate:api": "npm run db:migrate:data && npm run db:migrate:ops && npm run db:migrate:commerce",
    "check:pack-status-d1": "node --import tsx scripts/ops/checkPackStatusD1.ts",
    "check:ops-d1": "node --import tsx scripts/ops/checkOpsD1.ts",
    "check:commerce-d1": "node --import tsx scripts/ops/checkCommerceD1.ts",
    "check:queue-backlogs": "node --import tsx scripts/ops/checkQueueBacklogs.ts",
    "commerce-identity-manifest": "node --import tsx scripts/ops/commerceIdentityManifest.ts",
    "commerce-authority-control": "node --import tsx scripts/ops/commerceAuthorityControl.ts",
    "ready-notifications-control": "node --import tsx scripts/ops/readyNotificationsControl.ts",
    "reveal-submissions-control": "node --import tsx scripts/ops/revealSubmissionsControl.ts",
    "test-resend-notification-email": "tsx scripts/ops/sendTestResendNotificationEmail.ts",
    "wipe-drop": "node --experimental-strip-types scripts/ops/wipeDrop.ts",
    "deploy": "npm run check:frontend && wrangler deploy --strict --config wrangler.jsonc --env-file cloud/workers/frontend/release.env",
    "deploy:api": "npm run check:api && npm run db:migrate:api && npm run check:pack-status-d1 && npm run check:ops-d1 && npm run check:commerce-d1 && wrangler deploy --strict --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "deploy-all-onchain": "node --experimental-strip-types scripts/deploy-all-onchain.ts",
    "extend:shared-devnet": "node --experimental-strip-types scripts/extend-shared-devnet-program.ts",
    "deploy:lsb-uri-program": "node --experimental-strip-types scripts/deploy-lsb-uri-program.ts",
    "deploy:lsb-existing-uri-program": "node --experimental-strip-types scripts/deploy-lsb-uri-program.ts",
    "set:lsb-uri-base": "node --experimental-strip-types scripts/set-lsb-uri-base.ts",
    "deploy:poncho-uri-program": "node --experimental-strip-types scripts/deploy-poncho-uri-program.ts",
    "simulate:poncho-old-box": "node --experimental-strip-types scripts/simulate-poncho-old-box.ts",
    "set:poncho-uri-base": "node --experimental-strip-types scripts/set-poncho-uri-base.ts",
    "verify:mainnet-uri-migrations": "node --experimental-strip-types scripts/verify-mainnet-uri-migrations.ts",
    "deploy-receipt-pool": "node --experimental-strip-types scripts/deploy-receipt-pool.ts",
    "upgrade-onchain": "node --experimental-strip-types scripts/upgrade-onchain.ts",
    "start-mint": "node --experimental-strip-types scripts/startMint.ts",
    "set-mint-prices": "node --experimental-strip-types scripts/setMintPrices.ts",
    "export_collection_files": "node --experimental-strip-types scripts/exportCollectionFiles.ts",
    "get_token_holders": "node --experimental-strip-types scripts/getTokenHolders.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermetalmons/shop.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/supermetalmons/shop/issues"
  },
  "homepage": "https://github.com/supermetalmons/shop#readme",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-ledger": "^0.9.29",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "resend": "^6.18.1",
    "stripe": "22.4.0",
    "three": "^0.185.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "mediabunny": "^1.52.3",
    "npm-check-updates": "^23.0.1",
    "tsx": "^4.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "wrangler": "4.120.0"
  }
}
