{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "mons-shop-notifications",
  "account_id": "e25f90fc073ea309b54b8b5144bf28e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "queues": {
    "consumers": [
      {
        "queue": "mons-shop-notification-emails",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "mons-shop-notification-emails-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}
