{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "mons-shop-api",
  "account_id": "e25f90fc073ea309b54b8b5144bf28e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "api.mons.shop",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "HELIUS_API_KEY",
      "RESEND_CONTACTS_API_KEY",
      "NOTIFICATION_ENQUEUE_SECRET",
      "FIRESTORE_SERVICE_ACCOUNT_JSON",
      "FIRESTORE_WRITER_SERVICE_ACCOUNT_JSON",
      "ADDRESS_DECRYPTION_SECRET",
      "SHIPSTATION_API_KEY",
      "SHIPSTATION_SHIP_FROM",
      "STRIPE_SECRET_KEY",
      "STRIPE_RESTRICTED_KEY",
      "STRIPE_SECRET_KEY_LIVE",
      "STRIPE_RESTRICTED_KEY_LIVE"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_EMAIL_QUEUE",
        "queue": "mons-shop-notification-emails"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}
