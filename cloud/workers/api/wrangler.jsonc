{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "mons-shop-api",
	"account_id": "e25f90fc073ea309b54b8b5144bf28e0",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal"
	],
	"workers_dev": false,
	"preview_urls": true,
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"STRIPE_RECEIPT_CLAIM_ADMISSION_ENABLED": "true",
		"ETHEREUM_111K_CHAIN_ID": "11155111",
		"ETHEREUM_111K_CONTRACT_ADDRESS": "0x8b4044dbd10c05d84d067208980de58e9d5fe915",
		"ETHEREUM_111K_METADATA_BASE_URI": "https://cdn.mons.shop/111k-sepolia/",
		"ETHEREUM_111K_DEPLOYMENT_BLOCK": "12005467",
		"ETHEREUM_111K_RPC_URL": ""
	},
	"durable_objects": {
		"bindings": [{ "name": "ETHEREUM_REVEAL", "class_name": "EthereumRevealObject" }]
	},
	"migrations": [{ "tag": "ethereum-reveal-v1", "new_sqlite_classes": ["EthereumRevealObject"] }],
	"r2_buckets": [{ "binding": "ETHEREUM_REVEAL_METADATA", "bucket_name": "cdn-mons-shop" }],
	"d1_databases": [
		{
			"binding": "DATA_DB",
			"database_name": "mons-shop-data",
			"database_id": "4b09f942-b0c6-4a1e-81df-cb802fbf7099",
			"migrations_dir": "migrations"
		},
    {
      "binding": "OPS_DB",
      "database_name": "mons-shop-ops",
      "database_id": "6f8f6e7e-e6b1-4e1d-bd68-ece26fd918d5",
      "migrations_dir": "ops-migrations"
    },
    {
      "binding": "COMMERCE_DB",
      "database_name": "mons-shop-commerce",
      "database_id": "b9ff0689-3433-47f2-84c1-64677fe85db1",
      "migrations_dir": "commerce-migrations"
		}
	],
	"ratelimits": [
		{
			"name": "ETHEREUM_REVEAL_READ_RATE_LIMITER",
			"namespace_id": "1950264150",
			"simple": { "limit": 120000, "period": 60 }
		},
		{
			"name": "ETHEREUM_REVEAL_ADMISSION_RATE_LIMITER",
			"namespace_id": "1950264151",
			"simple": { "limit": 10000, "period": 60 }
		},
		{
			"name": "PREORDER_PREPARE_RATE_LIMITER",
			"namespace_id": "2185819631",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PREORDER_PREPARE_IP_RATE_LIMITER",
			"namespace_id": "2185819632",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "STAFF_AUTH_CHALLENGE_RATE_LIMITER",
			"namespace_id": "1142143110",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "STAFF_AUTH_SESSION_RATE_LIMITER",
			"namespace_id": "1361289553",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "ANONYMOUS_AUTH_SESSION_RATE_LIMITER",
			"namespace_id": "1874210346",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_RPC_READ_RATE_LIMITER",
			"namespace_id": "798946091",
			"simple": {
				"limit": 5000,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_RPC_WRITE_RATE_LIMITER",
			"namespace_id": "2126420685",
			"simple": {
				"limit": 500,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_SHOP_RATE_LIMITER",
			"namespace_id": "1950264148",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_NOTIFICATION_RATE_LIMITER",
			"namespace_id": "1844980764",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"routes": [
		{
			"pattern": "api.mons.shop",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"workflows": [
		{
			"binding": "ADMIN_IRL_REDEEM_FINALIZE_WORKFLOW",
			"name": "mons-shop-admin-irl-redeem-finalize-v1",
			"class_name": "AdminIrlRedeemFinalizeWorkflowV1"
		},
		{
			"binding": "STRIPE_RECEIPT_CLAIM_WORKFLOW",
			"name": "mons-shop-stripe-receipt-claim-v1",
			"class_name": "StripeReceiptClaimWorkflowV1"
		}
	],
	"secrets": {
		"required": [
			"ALCHEMY_MI_NOTE_API_KEY",
			"ETHEREUM_111K_SIGNER_SECRET",
			"OPENSEA_API_KEY",
			"HELIUS_API_KEY",
			"COSIGNER_SECRET",
			"RESEND_API_KEY",
			"RESEND_CONTACTS_API_KEY",
			"NOTIFICATION_ENQUEUE_SECRET",
			"ADDRESS_DECRYPTION_SECRET",
			"SHIPSTATION_API_KEY",
			"SHIPSTATION_SHIP_FROM",
			"STRIPE_SECRET_KEY",
			"STRIPE_RESTRICTED_KEY",
			"STRIPE_SECRET_KEY_LIVE",
			"STRIPE_RESTRICTED_KEY_LIVE",
			"STRIPE_WEBHOOK_SECRET_DEVNET",
			"STRIPE_WEBHOOK_SECRET"
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATION_EMAIL_QUEUE",
				"queue": "mons-shop-notification-emails"
			},
			{
				"binding": "REVEAL_BACKGROUND_QUEUE",
				"queue": "mons-shop-reveal-reconciliation"
			},
      {
        "binding": "STRIPE_FULFILLMENT_QUEUE",
        "queue": "mons-shop-stripe-fulfillment"
			}
		],
		"consumers": [
			{
				"queue": "mons-shop-notification-emails",
				"max_batch_size": 5,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 1,
				"dead_letter_queue": "mons-shop-notification-emails-dlq"
			},
			{
				"queue": "mons-shop-reveal-reconciliation",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 10,
				"max_concurrency": 1,
				"dead_letter_queue": "mons-shop-reveal-reconciliation-dlq"
			},
      {
        "queue": "mons-shop-stripe-fulfillment",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 10,
				"max_concurrency": 1,
        "retry_delay": 60,
        "dead_letter_queue": "mons-shop-stripe-fulfillment-dlq"
      }
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	}
}
