{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "mons-shop-api",
	"account_id": "e25f90fc073ea309b54b8b5144bf28e0",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal",
		"durable_object_io_tasks_prevent_eviction"
	],
	"workers_dev": false,
	"preview_urls": true,
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"RESEND_DROP_SEGMENT_IDS": {
			"111k": "576784c5-af45-4b8f-bf76-110aeef33126",
			"card_nft_2": "70093451-15ee-4c4c-88b8-592bb985ac1f",
			"card_nft_binder": "d7285a39-f123-4881-8f97-facd4054dd6e",
			"clear_cards": "2e526ae2-d75e-475f-99b4-44006eab01ae",
			"doge_day_2026": "d7892659-1a71-482d-a6fe-66c481717658",
			"drifella_shirt": "ad7fa4db-adb2-4398-9492-2b34b26179b0",
			"little_swag_boxes": "22f7f674-fbd1-40c2-944d-ab809776385b",
			"little_swag_hoodies": "1a65a410-edc6-4278-a8c0-8762c3062ca2",
			"mi_note_cards": "b90966b7-fbe8-4f25-982d-70dc54dad4f4",
			"poncho_drifella": "5fb2b9b7-05bf-4885-b37f-cb7f46e7d672",
			"tbd": "da83ebcc-f5fa-4146-a84b-64ce861cdc82"
		},
		"STRIPE_RECEIPT_CLAIM_ADMISSION_ENABLED": "true",
		"ETHEREUM_111K_CHAIN_ID": "11155111",
		"ETHEREUM_111K_CONTRACT_ADDRESS": "0x320cf00a3606350821ed90ea435e93955b180874",
		"ETHEREUM_111K_METADATA_BASE_URI": "https://cdn.mons.shop/111k-sepolia/v12/",
		"ETHEREUM_111K_DEPLOYMENT_BLOCK": "12043279",
		"ETHEREUM_111K_RPC_URL": "",
		"ETHEREUM_111K_DELIVERY_CONFIG_ID": "1",
		"ETHEREUM_PRE111K_MAINNET_CONTRACT_ADDRESS": "0x0a00d0a121cf14632845a16651d43941e8107f08",
		"ETHEREUM_PRE111K_MAINNET_DEPLOYMENT_BLOCK": "26326977",
		"ETHEREUM_PRE111K_MAINNET_ENABLED": "true",
		"ETHEREUM_PRE111K_SEPOLIA_CONTRACT_ADDRESS": "0x8dfde3c4a82ab6322ca5bd0306eb8cd2e75674b6",
		"ETHEREUM_PRE111K_SEPOLIA_DEPLOYMENT_BLOCK": "12047599",
		"ETHEREUM_PRE111K_SEPOLIA_ENABLED": "true"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ETHEREUM_REVEAL", "class_name": "EthereumRevealObject" },
			{ "name": "ETHEREUM_REVEAL_VERIFIER", "class_name": "EthereumRevealVerifierObject" },
			{ "name": "ETHEREUM_REVEAL_PUBLISHER", "class_name": "EthereumRevealPublisherObject" }
		]
	},
	"migrations": [
		{ "tag": "ethereum-reveal-v1", "new_sqlite_classes": ["EthereumRevealObject"] },
		{ "tag": "ethereum-reveal-verifier-v1", "new_sqlite_classes": ["EthereumRevealVerifierObject"] },
		{ "tag": "ethereum-reveal-publisher-v1", "new_sqlite_classes": ["EthereumRevealPublisherObject"] }
	],
	"r2_buckets": [{ "binding": "ETHEREUM_REVEAL_METADATA", "bucket_name": "cdn-mons-shop" }],
	"d1_databases": [
		{
			"binding": "DATA_DB",
			"database_name": "mons-shop-data",
			"database_id": "4b09f942-b0c6-4a1e-81df-cb802fbf7099",
			"migrations_dir": "migrations"
		},
    {
      "binding": "OPS_DB",
      "database_name": "mons-shop-ops",
      "database_id": "6f8f6e7e-e6b1-4e1d-bd68-ece26fd918d5",
      "migrations_dir": "ops-migrations"
    },
    {
      "binding": "COMMERCE_DB",
      "database_name": "mons-shop-commerce",
      "database_id": "b9ff0689-3433-47f2-84c1-64677fe85db1",
      "migrations_dir": "commerce-migrations"
		}
	],
	"ratelimits": [
		{
			"name": "ETHEREUM_REVEAL_READ_RATE_LIMITER",
			"namespace_id": "1950264150",
			"simple": { "limit": 120000, "period": 60 }
		},
		{
			"name": "ETHEREUM_REVEAL_ADMISSION_RATE_LIMITER",
			"namespace_id": "1950264151",
			"simple": { "limit": 10000, "period": 60 }
		},
		{
			"name": "PREORDER_PREPARE_RATE_LIMITER",
			"namespace_id": "2185819631",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PREORDER_PREPARE_IP_RATE_LIMITER",
			"namespace_id": "2185819632",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "STAFF_AUTH_CHALLENGE_RATE_LIMITER",
			"namespace_id": "1142143110",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "STAFF_AUTH_SESSION_RATE_LIMITER",
			"namespace_id": "1361289553",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "ANONYMOUS_AUTH_SESSION_RATE_LIMITER",
			"namespace_id": "1874210346",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_RPC_READ_RATE_LIMITER",
			"namespace_id": "798946091",
			"simple": {
				"limit": 5000,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_RPC_WRITE_RATE_LIMITER",
			"namespace_id": "2126420685",
			"simple": {
				"limit": 500,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_SHOP_RATE_LIMITER",
			"namespace_id": "1950264148",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_NOTIFICATION_RATE_LIMITER",
			"namespace_id": "1844980764",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"routes": [
		{
			"pattern": "api.mons.shop",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"workflows": [
		{
			"binding": "ADMIN_IRL_REDEEM_FINALIZE_WORKFLOW",
			"name": "mons-shop-admin-irl-redeem-finalize-v1",
			"class_name": "AdminIrlRedeemFinalizeWorkflowV1"
		},
		{
			"binding": "STRIPE_RECEIPT_CLAIM_WORKFLOW",
			"name": "mons-shop-stripe-receipt-claim-v1",
			"class_name": "StripeReceiptClaimWorkflowV1"
		}
	],
	"secrets": {
		"required": [
			"ALCHEMY_MI_NOTE_API_KEY",
			"ETHEREUM_111K_SIGNER_SECRET",
			"ETHEREUM_PRE111K_MAINNET_SIGNER_SECRET",
			"ETHEREUM_PRE111K_SEPOLIA_SIGNER_SECRET",
			"ETHEREUM_PRE111K_ACCESS_CODES",
			"OPENSEA_API_KEY",
			"HELIUS_API_KEY",
			"COSIGNER_SECRET",
			"RESEND_API_KEY",
			"RESEND_CONTACTS_API_KEY",
			"NOTIFICATION_ENQUEUE_SECRET",
			"ADDRESS_DECRYPTION_SECRET",
			"SHIPSTATION_API_KEY",
			"SHIPSTATION_SHIP_FROM",
			"STRIPE_SECRET_KEY",
			"STRIPE_RESTRICTED_KEY",
			"STRIPE_SECRET_KEY_LIVE",
			"STRIPE_RESTRICTED_KEY_LIVE",
			"STRIPE_WEBHOOK_SECRET_DEVNET",
			"STRIPE_WEBHOOK_SECRET"
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATION_EMAIL_QUEUE",
				"queue": "mons-shop-notification-emails"
			},
			{
				"binding": "REVEAL_BACKGROUND_QUEUE",
				"queue": "mons-shop-reveal-reconciliation"
			},
      {
        "binding": "STRIPE_FULFILLMENT_QUEUE",
        "queue": "mons-shop-stripe-fulfillment"
			}
		],
		"consumers": [
			{
				"queue": "mons-shop-notification-emails",
				"max_batch_size": 5,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 1,
				"dead_letter_queue": "mons-shop-notification-emails-dlq"
			},
			{
				"queue": "mons-shop-reveal-reconciliation",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 10,
				"max_concurrency": 1,
				"dead_letter_queue": "mons-shop-reveal-reconciliation-dlq"
			},
      {
        "queue": "mons-shop-stripe-fulfillment",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 10,
				"max_concurrency": 1,
        "retry_delay": 60,
        "dead_letter_queue": "mons-shop-stripe-fulfillment-dlq"
      }
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	}
}
