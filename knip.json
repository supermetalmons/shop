{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/renderer/main.tsx",
        "cloud/workers/api/src/index.ts",
        "cloud/workers/api/test/*.test.ts",
        "cloud/workers/api/runtime-test/*.test.ts",
        "scripts/*.{ts,cjs}",
        "scripts/newDrops/*.ts",
        "tests/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "cloud/workers/api/**/*.{ts,tsx}",
        "scripts/**/*.{ts,cjs}",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": ["buffer"],
      "ignoreBinaries": ["mkfifo", "solana"]
    },
    "functions": {
      "entry": ["scripts/*.ts", "../tests/*.test.ts"],
      "project": ["src/**/*.{ts,js}", "scripts/**/*.ts", "../tests/**/*.ts"],
      "ignoreBinaries": ["gcloud"]
    }
  }
}
