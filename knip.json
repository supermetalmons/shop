{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/renderer/main.tsx",
        "src/static-render/clearCards.tsx",
        "src/components/ClearCardDropPreview.tsx",
        "cloud/workers/api/src/index.ts",
        "cloud/workers/api/test/*.test.ts",
        "cloud/workers/api/runtime-test/*.test.ts",
        "cloud/workers/frontend/test/*.test.ts",
        "scripts/*.{ts,cjs}",
        "scripts/newDrops/*.ts",
        "scripts/ops/*.ts",
        "tests/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "cloud/workers/api/**/*.{ts,tsx}",
        "cloud/workers/frontend/**/*.{ts,tsx}",
        "scripts/**/*.{ts,cjs}",
        "shared/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": ["buffer"],
      "ignoreBinaries": ["anchor", "mkfifo", "solana"],
      "ignoreExportsUsedInFile": { "type": true }
    }
  }
}
